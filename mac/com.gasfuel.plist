        <integer>6</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/connorvandam/SERVER FILES/gas-fuel/fuel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/connorvandam/SERVER FILES/gas-fuel/fuel.log</string>
</dict>
</plist>
